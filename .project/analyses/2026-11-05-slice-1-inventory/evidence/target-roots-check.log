files="$(find . -type f -name '*.go' -not -path './.*' -print0 | xargs -0 -r gofmt -l)"; test -z "$files" || { printf '%s\n' "$files"; exit 1; }
mkdir -p "$REPO/.tmp"
cp go.mod "$REPO/.tmp/go.mod"
if test -f go.sum; then cp go.sum "$REPO/.tmp/go.sum"; else : > "$REPO/.tmp/go.sum"; fi
printf '\nreplace github.com/MichaelKinsy/PiG/extensions/sdk => %s\n' "$(pig reload --sdk-path)" >> "$REPO/.tmp/go.mod"
go vet -modfile="$REPO/.tmp/go.mod" ./...
go test -modfile="$REPO/.tmp/go.mod" ./...
